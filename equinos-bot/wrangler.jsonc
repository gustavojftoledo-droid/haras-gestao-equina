{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "equinos-bot",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],

  /**
   * Segredos (definir com `npx wrangler secret put NOME`):
   *   TELEGRAM_TOKEN        -> token do bot, dado pelo @BotFather
   *   TELEGRAM_WEBHOOK_SECRET -> qualquer string aleatoria; confere o header do webhook
   *   GCP_SERVICE_ACCOUNT   -> JSON inteiro da conta de servico do Firebase (uma linha)
   *   ALLOWED_CHAT_IDS      -> ids de chat do Telegram autorizados, separados por virgula
   *   ANTHROPIC_API_KEY     -> chave da API da Anthropic (console.anthropic.com) — a IA que entende as frases
   */
  "vars": {
    "FIREBASE_PROJECT_ID": "equinos-manager",
    "FIRESTORE_COLLECTION": "harasData"
  },

  /* 07:00 e 19:00 de Brasília (UTC-3, sem horário de verão) -> 10:00 e 22:00 UTC.
     Relatórios diários no Telegram: "o que fazer hoje" / "o que foi feito hoje". */
  "triggers": {
    "crons": ["0 10 * * *", "0 22 * * *"]
  },

  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "70f2e3abf0404e959ca1e256c05ba617"
    }
  ],

  "observability": { "enabled": true }
}
