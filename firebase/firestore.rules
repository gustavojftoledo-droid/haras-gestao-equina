rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    // Usuário SEM claim "tenantId" = haras original (Gustavo): continua só na coleção antiga.
    function ehHarasOriginal() { return logado() && !('tenantId' in request.auth.token); }
    function ehDoCliente(tid) { return logado() && ('tenantId' in request.auth.token) && request.auth.token.tenantId == tid; }

    match /harasData/{doc} {
      allow read, write: if ehHarasOriginal();
    }
    match /tenants/{tid}/dados/{doc} {
      allow read, write: if ehDoCliente(tid);
    }
    // Todo o resto fica bloqueado.
    match /{outro=**} {
      allow read, write: if false;
    }
  }
}
